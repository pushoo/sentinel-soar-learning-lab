// DCR transform for SignInDemo_CL (paste into the custom-table wizard's transformation editor).
// Runs at ingestion time, before you pay to store the data.
source
| where isnotempty(UserPrincipalName) and isnotempty(IPAddress)
| extend TimeGenerated = todatetime(TimeGenerated)
| extend ResultType = toint(ResultType)
| extend UserPrincipalName = tolower(UserPrincipalName)
